{
  "manifest_version": 3,
  "name": "mc-meet",
  "version": "0.1.0",
  "description": "Streams Google Meet captions, chat and participants to the meeting-capture app.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": ["https://meet.google.com/*"],
  "icons": { "16": "icons/idle-16.png", "32": "icons/idle-32.png" },
  "action": {
    "default_icon": { "16": "icons/idle-16.png", "32": "icons/idle-32.png" },
    "default_title": "mc-meet",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["page/wire.js", "page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "call-events.js",
        "content/selectors.js",
        "content/dom-readers.js",
        "content/caption-source.js",
        "content/main.js"
      ],
      "run_at": "document_start"
    }
  ]
}
