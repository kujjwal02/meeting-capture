{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Capture",
  "identifier": "com.ujjwalkumar.meetingcapture",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Turns calls into meeting notes in your vault",
    "copyright": "© 2026 Ujjwal Kumar. MIT licence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEREYxM0U5MDdFQjMyQUIKUldTck11c0g2UlBmZlJpOEZHVERNc1Bqb21WV2NKSzBrZ1p4b2kvQ1FJUnl0djVPWktEdzdNWTUK",
      "endpoints": [
        "https://github.com/kujjwal02/meeting-capture/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
